# =============================================================================
# api-catalog — variables de entorno para desarrollo local
# =============================================================================
# Copiar como configs/.env.local de este mismo servicio:
#
#   cp services/api-catalog/configs/.env.example \
#      services/api-catalog/configs/.env.local
#
# Orden de carga de `make dev service=services/api-catalog stage=local`
# (scripts/dev-service.ts), de menor a mayor precedencia:
#
#   1. configs/.env.local de la raiz — perfil y region de AWS, comunes a todos
#      los servicios
#   2. configs/.env.local de este servicio — este archivo
#   3. provider.environment de serverless.ts — solo cuando stage != local
#
# Con stage=local no se resuelve SSM: las variables salen de estos archivos.
# En AWS los valores los inyecta serverless.ts desde SSM Parameter Store tipo
# SecureString, y este archivo no participa del despliegue.
#
# NO PONER SECRETOS REALES ACA: este archivo se versiona. Un secreto va a SSM,
# y su valor de desarrollo al configs/.env.local (ignorado por git).
# =============================================================================

# --- DynamoDB ---
# Tabla `catalogos` del stack indomito-hub-infra-ddb (repo ind-hub-inf).
# Nombre: ind-{stage}-catalogos-ddb-{stage}-pri-use1
# Guarda los catalogos, los parametros de margen y el snapshot de respaldo de
# tasas de cambio (pk = RATES, sk = LATEST).
#
# Apunta a la tabla real de dev: el servidor local escribe y lee de AWS con el
# perfil del configs/.env.local de la raiz. No hay DynamoDB local.
CATALOGS_TABLE_NAME=ind-dev-catalogos-ddb-dev-pri-use1
CONFIGURATIONS_TABLE_NAME=ind-dev-configuraciones-ddb-dev-pri-use1

# --- Tasas de cambio ---
# Token gratuito de la API BDE del Banco Central de Chile. Si se omite, el
# endpoint usa mindicador.cl para USD y la fuente secundaria para BRL antes de
# recurrir al snapshot persistido.
BCCH_API_TOKEN=

# --- Observabilidad ---
# En local conviene `debug`; en AWS el valor por defecto es `info`.
LOG_LEVEL=debug
