{
  "openapi": "3.1.0",
  "info": {
    "title": "Indomito Hub Inbox API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ConversationSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phone", "alias", "channel", "status", "reason", "reasonLabel", "agentProcessing", "agentProcessingUntil", "unreadCount", "lastMessagePreview", "lastMessageAt", "serviceWindowExpiresAt", "createdAt", "updatedAt", "generation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phone": { "type": "string", "pattern": "^[0-9]{8,15}$" },
          "alias": { "type": "string", "maxLength": 100 },
          "channel": { "type": "string", "const": "whatsapp" },
          "status": { "type": "string", "enum": ["bot", "derived"] },
          "reason": { "type": ["string", "null"] },
          "reasonLabel": { "type": ["string", "null"] },
          "agentProcessing": { "type": "boolean" },
          "agentProcessingUntil": { "type": ["string", "null"], "format": "date-time" },
          "unreadCount": { "type": "integer", "minimum": 0 },
          "lastMessagePreview": { "type": ["string", "null"], "maxLength": 200 },
          "lastMessageAt": { "type": ["string", "null"], "format": "date-time" },
          "serviceWindowExpiresAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": ["string", "null"], "format": "date-time" },
          "updatedAt": { "type": ["string", "null"], "format": "date-time" },
          "generation": { "type": "integer", "minimum": 0 }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "pageSize", "totalItems", "totalPages"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "const": 200 },
          "totalItems": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      },
      "ListWatermark": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream", "sequence"],
        "properties": {
          "stream": { "type": "string", "const": "list" },
          "sequence": { "type": "integer", "minimum": 0 }
        }
      },
      "DetailWatermark": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream", "sequence"],
        "properties": {
          "stream": { "type": "string", "pattern": "^detail:[0-9]{8,15}$" },
          "sequence": { "type": "integer", "minimum": 0 }
        }
      },
      "MessageAttachment": {
        "type": "object", "additionalProperties": false,
        "required": ["fileName", "mimeType", "size", "downloadUrl"],
        "properties": {
          "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png", "image/gif", "image/webp", "audio/ogg", "audio/webm", "audio/mpeg", "audio/mp4", "audio/wav", "audio/flac", "audio/amr", "video/mp4"] },
          "size": { "type": "integer", "minimum": 1, "maximum": 16777216 },
          "downloadUrl": { "type": ["string", "null"] }
        }
      },
      "Message": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "msgSk", "phone", "type", "content", "createdAt", "whatsappMessageId", "deliveryStatus", "deliveryError", "attachments", "replyTo", "reactions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, "msgSk": { "type": "string", "pattern": "^MSG#[0-9A-HJKMNP-TV-Z]{26}$" },
          "phone": { "type": "string", "pattern": "^[0-9]{8,15}$" }, "type": { "type": "string", "enum": ["customer", "ai_agent", "team"] },
          "content": { "type": ["string", "null"], "maxLength": 4096 }, "createdAt": { "type": "string", "format": "date-time" },
          "whatsappMessageId": { "type": ["string", "null"], "maxLength": 256 }, "deliveryStatus": { "type": ["string", "null"], "enum": ["sent", "delivered", "read", "failed", null] },
          "deliveryError": { "type": ["string", "null"], "maxLength": 200 }, "attachments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/components/schemas/MessageAttachment" } },
          "replyTo": { "anyOf": [{ "$ref": "#/components/schemas/MessageReference" }, { "type": "null" }] }, "reactions": { "type": "array", "maxItems": 2, "items": { "$ref": "#/components/schemas/MessageReaction" } },
          "rich": { "$ref": "#/components/schemas/MessageRichContent" }
        }
      },
      "MessageReference": { "type": "object", "additionalProperties": false, "required": ["id", "type", "content", "whatsappMessageId"], "properties": { "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, "type": { "type": "string", "enum": ["customer", "ai_agent", "team"] }, "content": { "type": ["string", "null"], "maxLength": 4096 }, "whatsappMessageId": { "type": "string", "minLength": 1, "maxLength": 256 } } },
      "MessageReaction": { "type": "object", "additionalProperties": false, "required": ["emoji", "actor", "updatedAt"], "properties": { "emoji": { "type": "string", "minLength": 1, "maxLength": 8 }, "actor": { "type": "string", "enum": ["customer", "team"] }, "updatedAt": { "type": "string", "format": "date-time" } } },
      "SendAttachmentSummary": {
        "type": ["object", "null"], "additionalProperties": false,
        "required": ["fileName", "mimeType", "size"],
        "properties": { "fileName": { "type": "string", "minLength": 1, "maxLength": 200 }, "mimeType": { "type": "string" }, "size": { "type": "integer", "minimum": 1, "maximum": 7340032 } }
      },
      "SendState": {
        "type": "object", "additionalProperties": false,
        "required": ["clientMessageId", "phone", "state", "createdAt", "updatedAt", "retryCount", "preview", "attachment"],
        "properties": {
          "clientMessageId": { "type": "string", "format": "uuid" }, "phone": { "type": "string", "pattern": "^[0-9]{8,15}$" },
          "state": { "type": "string", "enum": ["reserved", "provider_pending", "recovering", "uncertain", "failed_retryable", "committed", "failed"] },
          "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 },
          "preview": { "type": ["string", "null"], "maxLength": 200 }, "attachment": { "$ref": "#/components/schemas/SendAttachmentSummary" },
          "whatsappMessageId": { "type": "string", "minLength": 1, "maxLength": 256 }, "resolutionRequired": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
          "retryAvailable": { "type": "boolean" }, "error": { "type": "string", "minLength": 1, "maxLength": 200 },
          "result": { "type": "object", "additionalProperties": false, "required": ["whatsappMessageId", "msgSk", "createdAt"], "properties": { "whatsappMessageId": { "type": "string" }, "msgSk": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } }
        }
      },
      "SendReplyRequest": { "type": "object", "additionalProperties": false, "required": ["content", "clientMessageId"], "properties": { "content": { "type": "string", "minLength": 1, "maxLength": 4096 }, "clientMessageId": { "type": "string", "format": "uuid" }, "replyToMessageId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" } } },
      "MessageTemplate": { "type": "object", "additionalProperties": false, "required": ["name", "language", "category", "status", "body", "parameterCount", "supported"], "properties": { "name": { "type": "string" }, "language": { "type": "string" }, "category": { "type": "string" }, "status": { "type": "string", "const": "APPROVED" }, "body": { "type": "string" }, "parameterCount": { "type": "integer", "minimum": 0, "maximum": 20 }, "supported": { "type": "boolean" } } },
      "SendTemplateRequest": { "type": "object", "additionalProperties": false, "required": ["clientMessageId", "name", "language", "parameters"], "properties": { "clientMessageId": { "type": "string", "format": "uuid" }, "name": { "type": "string", "pattern": "^[a-z0-9_]{1,512}$" }, "language": { "type": "string", "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$" }, "parameters": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } } } },
      "SendReactionRequest": { "type": "object", "additionalProperties": false, "required": ["messageId", "emoji"], "properties": { "messageId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, "emoji": { "type": "string", "maxLength": 8 } } },
      "MessageLocation": { "type": "object", "additionalProperties": false, "required": ["latitude", "longitude", "name", "address"], "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 }, "name": { "type": "string", "maxLength": 1000 }, "address": { "type": "string", "maxLength": 1000 } } },
      "MessageContact": { "type": "object", "additionalProperties": false, "required": ["name", "phone", "email", "company"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "phone": { "type": "string", "minLength": 8, "maxLength": 16 }, "email": { "type": "string", "maxLength": 254 }, "company": { "type": "string", "maxLength": 200 } } },
      "MessageInteractiveReply": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "title", "description"], "properties": { "kind": { "type": "string", "enum": ["button_reply", "list_reply"] }, "id": { "type": "string", "maxLength": 256 }, "title": { "type": "string", "maxLength": 200 }, "description": { "type": "string", "maxLength": 200 } } },
      "MessageInteractiveOption": { "type": "object", "additionalProperties": false, "required": ["id", "title", "description"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "title": { "type": "string", "minLength": 1, "maxLength": 24 }, "description": { "type": "string", "maxLength": 72 } } },
      "MessageInteractive": { "type": "object", "additionalProperties": false, "required": ["kind", "body", "footer", "button", "options"], "properties": { "kind": { "type": "string", "enum": ["button", "list"] }, "body": { "type": "string", "minLength": 1, "maxLength": 1024 }, "footer": { "type": "string", "maxLength": 60 }, "button": { "type": "string", "maxLength": 20 }, "options": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/components/schemas/MessageInteractiveOption" } } } },
      "MessageRichContent": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "type": "string", "enum": ["location", "contacts", "sticker", "interactive_reply", "interactive"] }, "location": { "$ref": "#/components/schemas/MessageLocation" }, "contacts": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/MessageContact" } }, "interactiveReply": { "$ref": "#/components/schemas/MessageInteractiveReply" }, "interactive": { "$ref": "#/components/schemas/MessageInteractive" } } },
      "SendRichMessageRequest": { "type": "object", "additionalProperties": false, "required": ["clientMessageId", "kind"], "properties": { "clientMessageId": { "type": "string", "format": "uuid" }, "kind": { "type": "string", "enum": ["location", "contacts", "interactive"] }, "location": { "$ref": "#/components/schemas/MessageLocation" }, "contacts": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/components/schemas/MessageContact" } }, "interactive": { "$ref": "#/components/schemas/MessageInteractive" } } },
      "RetrySendRequest": { "type": "object", "additionalProperties": false, "properties": {} },
      "ResolveSendRequest": { "type": "object", "additionalProperties": false, "required": ["resolution", "reason"], "properties": { "resolution": { "type": "string", "enum": ["delivered", "not_delivered"] }, "whatsappMessageId": { "type": "string", "minLength": 1, "maxLength": 256 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } } },
      "UpdateContactRequest": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100 } } },
      "UpdateContactResponse": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["phone", "name"], "properties": { "phone": { "type": "string", "pattern": "^[0-9]{8,15}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 100 } } } } },
      "AttachmentPreparationItem": { "type": "object", "additionalProperties": false, "required": ["clientMessageId", "fileName", "mimeType", "size", "checksumSha256"], "properties": { "clientMessageId": { "type": "string", "format": "uuid" }, "fileName": { "type": "string", "minLength": 1, "maxLength": 200 }, "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png", "image/webp", "audio/ogg", "audio/aac", "audio/mp4", "audio/mpeg", "audio/amr", "video/mp4"] }, "size": { "type": "integer", "minimum": 1, "maximum": 7340032 }, "checksumSha256": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" } } },
      "PrepareAttachmentsRequest": { "type": "object", "additionalProperties": false, "required": ["batchId", "files"], "properties": { "batchId": { "type": "string", "format": "uuid" }, "files": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/AttachmentPreparationItem" } } } },
      "PreparedAttachmentUpload": { "type": "object", "additionalProperties": false, "required": ["clientMessageId", "uploadId", "key", "uploadUrl", "method", "requiredHeaders"], "properties": { "clientMessageId": { "type": "string", "format": "uuid" }, "uploadId": { "type": "string", "format": "uuid" }, "key": { "type": "string" }, "uploadUrl": { "type": "string", "format": "uri" }, "method": { "type": "string", "const": "PUT" }, "requiredHeaders": { "type": "object", "additionalProperties": { "type": "string" }, "required": ["Content-Type", "x-amz-checksum-sha256", "x-amz-meta-upload-id"], "properties": { "Content-Type": { "type": "string" }, "x-amz-checksum-sha256": { "type": "string" }, "x-amz-meta-upload-id": { "type": "string" } } } } },
      "PrepareAttachmentsResponse": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["batchId", "expiresAt", "uploads"], "properties": { "batchId": { "type": "string", "format": "uuid" }, "expiresAt": { "type": "string", "format": "date-time" }, "uploads": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/components/schemas/PreparedAttachmentUpload" } } } } } },
      "SendAttachmentRequest": { "type": "object", "additionalProperties": false, "required": ["uploadId", "key", "caption", "clientMessageId"], "properties": { "uploadId": { "type": "string", "format": "uuid" }, "key": { "type": "string", "minLength": 1, "maxLength": 1024 }, "caption": { "type": "string", "maxLength": 1024 }, "clientMessageId": { "type": "string", "format": "uuid" }, "kind": { "type": "string", "const": "sticker" } } },
      "MarkUnreadRequest": { "type": "object", "additionalProperties": false, "required": ["unread"], "properties": { "unread": { "type": "boolean", "const": true } } },
      "ReactivateAgentRequest": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "type": "string", "const": "bot" } } },
      "DeleteConversationResponse": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "data": { "type": "object", "additionalProperties": false, "required": ["deleted"], "properties": { "deleted": { "type": "boolean", "const": true } } } } },
      "SendStateResponse": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/SendState" } } },
      "ConversationListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pageInfo", "nextCursor", "unreadTotal", "watermark"],
        "properties": {
          "data": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/ConversationSummary" } },
          "pageInfo": { "$ref": "#/components/schemas/PageInfo" },
          "nextCursor": { "type": ["string", "null"], "minLength": 1, "maxLength": 2048 },
          "unreadTotal": { "type": "integer", "minimum": 0 },
          "watermark": { "$ref": "#/components/schemas/ListWatermark" }
        },
        "examples": [{
          "data": [],
          "pageInfo": { "page": 1, "pageSize": 200, "totalItems": 0, "totalPages": 0 },
          "nextCursor": null,
          "unreadTotal": 0,
          "watermark": { "stream": "list", "sequence": 0 }
        }]
      },
      "ValidationDetails": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "ConversationDetailResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "conversation", "messages", "hasMore", "nextCursor", "nonTerminalSends", "watermark"],
            "properties": {
              "mode": { "type": "string", "enum": ["full", "before", "delta"] },
              "conversation": { "oneOf": [{ "$ref": "#/components/schemas/ConversationSummary" }, { "type": "null" }] },
              "messages": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } },
              "hasMore": { "type": "boolean" },
              "nextCursor": { "type": ["string", "null"], "maxLength": 2048 },
              "nonTerminalSends": { "type": "array", "items": { "$ref": "#/components/schemas/SendState" } },
              "watermark": { "$ref": "#/components/schemas/DetailWatermark" },
              "requestedBefore": { "type": "string" },
              "requestedSince": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "BulkOperation": {
        "type": "object", "additionalProperties": false,
        "required": ["operationId", "kind", "state", "phase", "initiatorUserId", "checkpoint", "snapshotComplete", "targetCount", "processed", "applied", "unchanged", "failed", "createdAt", "updatedAt", "completedAt", "failureCode"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "kind": { "type": "string", "enum": ["mark_all_read", "recalculate_unread"] },
          "state": { "type": "string", "enum": ["materializing", "applying", "committed", "failed"] },
          "phase": { "type": ["string", "null"] }, "initiatorUserId": { "type": "string", "minLength": 1 },
          "checkpoint": { "type": ["string", "null"] }, "snapshotComplete": { "type": "boolean" },
          "targetCount": { "type": "integer", "minimum": 0 }, "processed": { "type": "integer", "minimum": 0 },
          "applied": { "type": "integer", "minimum": 0 }, "unchanged": { "type": "integer", "minimum": 0 }, "failed": { "type": "integer", "minimum": 0 },
          "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": ["string", "null"], "format": "date-time" }, "failureCode": { "type": ["string", "null"] }
        }
      },
      "Subscription": { "type": "object", "additionalProperties": false, "required": ["url", "ticket", "expiresAt"], "properties": { "url": { "type": "string", "pattern": "^wss://" }, "ticket": { "type": "string", "minLength": 43, "maxLength": 43 }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "details", "traceId"],
        "properties": {
          "code": {
            "type": "string",
            "enum": ["VALIDATION_INPUT_INVALID", "VALIDATION_PHONE_INVALID", "VALIDATION_CURSOR_INVALID", "VALIDATION_IDEMPOTENCY_KEY_INVALID", "INBOX_CURSOR_EXPIRED", "AUTH_UNAUTHORIZED", "RESOURCE_NOT_FOUND", "INBOX_SERVICE_WINDOW_CLOSED", "INBOX_IDEMPOTENCY_CONFLICT", "INBOX_BULK_CONFLICT", "INBOX_SEND_NOT_RETRYABLE", "INBOX_SEND_RETRY_EXHAUSTED", "INBOX_SEND_NOT_RESOLVABLE", "INBOX_PROVIDER_REJECTED", "INBOX_SNAPSHOT_LIMIT_REACHED", "INBOX_CAPACITY_UNAVAILABLE", "INTERNAL_ERROR"]
          },
          "message": { "type": "string", "minLength": 1 },
          "details": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/ValidationDetails" }] },
          "traceId": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "paths": {
    "/configuracion-agente": {
      "get": { "operationId": "getAgentManagement", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Borrador, version publicada e historial" }, "401": { "description": "No autenticado" }, "500": { "description": "Fallo interno" } } }
    },
    "/configuracion-agente/metricas": {
      "get": { "operationId": "getOperationalMetrics", "security": [{ "BearerAuth": [] }], "responses": { "200": { "description": "Consumo mensual del agente y metricas AWS cacheadas" }, "401": { "description": "No autenticado" }, "403": { "description": "Perfil sin acceso" }, "500": { "description": "Fallo interno" } } }
    },
    "/configuracion-agente/borrador": {
      "put": { "operationId": "saveAgentDraft", "security": [{ "BearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Borrador validado" }, "400": { "description": "Configuracion invalida" }, "401": { "description": "No autenticado" } } }
    },
    "/configuracion-agente/publicaciones": {
      "post": { "operationId": "publishAgentConfig", "security": [{ "BearerAuth": [] }], "responses": { "201": { "description": "Configuracion publicada" }, "400": { "description": "Borrador invalido" }, "401": { "description": "No autenticado" } } }
    },
    "/configuracion-agente/restauraciones": {
      "post": { "operationId": "restoreAgentConfig", "security": [{ "BearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string", "minLength": 1 } } } } } }, "responses": { "201": { "description": "Version restaurada y publicada" }, "400": { "description": "Version invalida" }, "401": { "description": "No autenticado" } } }
    },
    "/configuracion-agente/programas/cargas": {
      "post": { "operationId": "prepareAgentProgramUpload", "security": [{ "BearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["fileName", "size"], "properties": { "fileName": { "type": "string", "pattern": "(?i)\\.pdf$" }, "size": { "type": "integer", "minimum": 1, "maximum": 33554432 } } } } } }, "responses": { "200": { "description": "Carga firmada por diez minutos" }, "400": { "description": "Archivo invalido" }, "401": { "description": "No autenticado" } } }
    },
    "/configuracion-agente/programas/descargas": {
      "get": { "operationId": "prepareAgentProgramDownload", "security": [{ "BearerAuth": [] }], "parameters": [{ "name": "documentKey", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1 } }, { "name": "fileName", "in": "query", "required": false, "schema": { "type": "string", "pattern": "(?i)\\.pdf$" } }], "responses": { "200": { "description": "Descarga privada firmada por cinco minutos" }, "400": { "description": "PDF invalido" }, "401": { "description": "No autenticado" } } }
    },
    "/conversaciones": {
      "get": {
        "operationId": "listConversations",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "X-Correlation-Id", "in": "header", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer", "const": 200, "default": 200 } },
