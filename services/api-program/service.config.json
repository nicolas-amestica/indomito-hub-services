{
  "name": "api-program",
  "localPort": 8083,
  "localEntrypoint": "./cmd/local-api",
  "defaultArtifactDir": ".serverless-artifacts",
  "requiredEnvironment": [
    "APP_NAME",
    "APP_STAGE",
    "APP_REGION",
    "PROGRAMS_TABLE_NAME"
  ],
  "functions": [
    { "name": "fn-listar-cotizaciones-v1", "entrypoint": "./cmd/fn-listar-cotizaciones-v1" },
    { "name": "fn-crear-cotizacion-v1", "entrypoint": "./cmd/fn-crear-cotizacion-v1" },
    { "name": "fn-actualizar-cotizacion-v1", "entrypoint": "./cmd/fn-actualizar-cotizacion-v1" },
    { "name": "fn-eliminar-cotizacion-v1", "entrypoint": "./cmd/fn-eliminar-cotizacion-v1" },
    {
      "name": "fn-generar-presupuesto-v1",
      "entrypoint": "./cmd/fn-generar-presupuesto-v1"
    }
  ]
}
