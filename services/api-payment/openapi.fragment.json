{
  "paths": {
    "/pagos/documentos-tributarios/recibidos/sincronizaciones": {
      "post": {
        "summary": "Solicita sincronización manual asíncrona del correo tributario",
        "responses": { "202": { "description": "Envelope queued/request/lastSuccess. request contiene id ULID, status PENDING/RUNNING/COMPLETED/FAILED, fechas y detail. queued=false reutiliza una solicitud activa o reciente. El 202 no confirma procesamiento." }, "403": { "description": "Solo administrador de pagos" }, "502": { "description": "No fue posible solicitar la sincronización" } }
      }
    },
    "/pagos/documentos-tributarios/recibidos/sincronizaciones/{requestId}": {
      "get": {
        "summary": "Consulta el estado persistido de una sincronización manual",
        "parameters": [{"name":"requestId","in":"path","required":true,"schema":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{26}$"}}],
        "responses": {"200":{"description":"Envelope request; no-store. Solo COMPLETED confirma lectura terminada. Las esperas vencidas quedan FAILED."},"403":{"description":"Solo administrador de pagos"},"404":{"description":"Solicitud no encontrada"}}
      }
    },
    "/pagos/documentos-tributarios/recibidos": {
      "get": {
        "summary": "Lista DTE recibidos por mes de emisión",
        "parameters": [
          { "name": "month", "in": "query", "required": true, "schema": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Envelope con items, nextCursor, sync, issues y manualSync (última solicitud manual o null); no-store" }, "403": { "description": "Solo administrador de pagos" } }
      }
    },
    "/pagos/documentos-tributarios/recibidos/{documentId}/eventos": {
      "parameters": [
        { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        { "name": "month", "in": "query", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "summary": "Consulta o registra aceptación, acuse o reclamo SII",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "action": { "type": "string", "enum": ["", "ACD", "ERM", "RCD", "RFP", "RFT"] }, "commandId": { "type": "string" }, "reason": { "type": "string", "maxLength": 500 }, "confirmed": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "Envelope document/result/successful; revisar result.code, no solo HTTP" }, "409": { "description": "Conflicto, comando usado o decisión incompatible" }, "503": { "description": "Servicio no disponible; consultar SII antes de repetir decisión" } }
      }
    },
    "/pagos/documentos-tributarios/recibidos/{documentId}/descarga": {
      "parameters": [
        { "name": "documentId", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "month", "in": "query", "required": true, "schema": { "type": "string" } }
      ],
      "get": { "summary": "Descarga original XML mediante URL temporal privada", "responses": { "200": { "description": "Envelope con url firmada por dos minutos" } } }
    },
    "/pagos/boletas/consultas": {
      "post": {
        "summary": "Consulta publica de una boleta electronica",
        "security": [],
        "responses": { "200": { "description": "Coincidencia exacta con queryStatus, issuedByIndomito y siiStatus independiente: PENDING, ACCEPTED, ACCEPTED_WITH_REPAIRS, REJECTED o UNKNOWN. La respuesta puede incluir originalFolio, replacementFolio y replacementPending sin datos personales ni administrativos." }, "429": { "description": "Límite temporal de consultas" }, "503": { "description": "Consulta temporalmente no disponible; no implica rechazo" } }
      }
    },
    "/pagos/portal/checkout": {
      "post": {
        "summary": "Inicia el pago de la primera cuota pendiente",
        "description": "La respuesta identifica la cuota congelada para el intento mediante installmentNumber. El asunto enviado a Khipu usa esa misma cuota y el identificador del contrato.",
        "responses": {
          "200": {
            "description": "Intento de pago",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalAttemptResponse" } } }
          },
          "409": { "description": "PAYMENT_CHECKOUT_DISABLED cuando se impiden nuevos cobros. Los intentos existentes siguen consultables e idempotentes." },
          "503": { "description": "Configuración o dependencia temporalmente no disponible; no se reserva un cobro nuevo." }
        }
      }
    },
    "/pagos/portal/intentos/{id}": {
      "get": {
        "summary": "Consulta el estado de un intento de pago",
        "responses": {
          "200": {
            "description": "Estado y cuota asociada al intento",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalAttemptResponse" } } }
          }
        }
      }
    },
    "/pagos/documentos-tributarios/configuracion": {
      "get": { "summary": "Obtiene el resumen de configuración tributaria", "responses": { "200": { "description": "Configuración sin secretos" } } },
      "put": { "summary": "Actualiza metadatos del emisor", "responses": { "200": { "description": "Configuración actualizada" } } }
    },
    "/pagos/documentos-tributarios/configuracion/caf": {
      "post": { "summary": "Carga un CAF DTE tipo 39", "responses": { "200": { "description": "CAF validado y almacenado" } } }
    },
    "/pagos/documentos-tributarios/configuracion/pfx": {
      "post": { "summary": "Carga un certificado PFX", "responses": { "200": { "description": "Certificado validado y almacenado" } } }
    },
    "/pagos/documentos-tributarios/emisiones": {
      "post": {
        "summary": "Encola una boleta electrónica para emisión",
        "description": "Si deliveryEmail contiene un correo válido, la representación PDF se entrega de forma asíncrona después de la emisión. Si se omite o queda vacío, no se envía correo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commandId", "issueDate", "customerRut", "items"],
                "properties": {
                  "commandId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "issueDate": { "type": "string", "format": "date" },
                  "customerRut": { "type": "string", "maxLength": 12 },
                  "deliveryEmail": { "type": "string", "format": "email", "maxLength": 254 },
                  "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Boleta encolada para emisión" },
          "400": { "description": "Solicitud o correo inválido" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PortalAttemptResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string" },
              "installmentNumber": { "type": "integer", "minimum": 1 },
              "paymentUrl": { "type": "string", "format": "uri" },
              "receiptReady": { "type": "boolean", "deprecated": true, "description": "Compatibilidad: indica que el PDF del comprobante está disponible; no acredita envío." },
              "receiptStatus": { "type": "string", "enum": ["PREPARING", "AVAILABLE"] },
              "receiptDeliveryStatus": { "type": "string", "enum": ["PENDING", "SMTP_ACCEPTED", "FAILED_RETRYING", "FAILED", "NOT_REQUESTED", "UNKNOWN"] },
              "receiptRecoveryAvailable": { "type": "boolean" },
              "taxDocumentStatus": { "type": "string", "enum": ["PREPARING", "SUBMITTED", "ACCEPTED", "ACCEPTED_WITH_REPAIRS", "REJECTED", "REISSUE_PENDING", "UNKNOWN"] },
              "taxDocumentDeliveryStatus": { "type": "string", "enum": ["PENDING", "SMTP_ACCEPTED", "DOCUMENT_READY_NO_RECIPIENT", "FAILED_RETRYING", "FAILED", "UNKNOWN"] },
              "taxDocumentRecoveryAvailable": { "type": "boolean" },
              "lastCheckedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
