{
  "paths": {
    "/pagos/boletas/consultas": {
      "post": {
        "summary": "Consulta publica de una boleta electronica",
        "security": [],
        "responses": { "200": { "description": "Resultado de la consulta" } }
      }
    },
    "/pagos/portal/checkout": {
      "post": {
        "summary": "Inicia el pago de la primera cuota pendiente",
        "description": "La respuesta identifica la cuota congelada para el intento mediante installmentNumber. El asunto enviado a Khipu usa esa misma cuota y el identificador del contrato.",
        "responses": {
          "200": {
            "description": "Intento de pago",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalAttemptResponse" } } }
          }
        }
      }
    },
    "/pagos/portal/intentos/{id}": {
      "get": {
        "summary": "Consulta el estado de un intento de pago",
        "responses": {
          "200": {
            "description": "Estado y cuota asociada al intento",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PortalAttemptResponse" } } }
          }
        }
      }
    },
    "/pagos/documentos-tributarios/configuracion": {
      "get": { "summary": "Obtiene el resumen de configuración tributaria", "responses": { "200": { "description": "Configuración sin secretos" } } },
      "put": { "summary": "Actualiza metadatos del emisor", "responses": { "200": { "description": "Configuración actualizada" } } }
    },
    "/pagos/documentos-tributarios/configuracion/caf": {
      "post": { "summary": "Carga un CAF DTE tipo 39", "responses": { "200": { "description": "CAF validado y almacenado" } } }
    },
    "/pagos/documentos-tributarios/configuracion/pfx": {
      "post": { "summary": "Carga un certificado PFX", "responses": { "200": { "description": "Certificado validado y almacenado" } } }
    },
    "/pagos/documentos-tributarios/emisiones": {
      "post": {
        "summary": "Encola una boleta electrónica para emisión",
        "description": "Si deliveryEmail contiene un correo válido, la representación PDF se entrega de forma asíncrona después de la emisión. Si se omite o queda vacío, no se envía correo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["commandId", "issueDate", "customerRut", "items"],
                "properties": {
                  "commandId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
                  "issueDate": { "type": "string", "format": "date" },
                  "customerRut": { "type": "string", "maxLength": 12 },
                  "deliveryEmail": { "type": "string", "format": "email", "maxLength": 254 },
                  "items": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Boleta encolada para emisión" },
          "400": { "description": "Solicitud o correo inválido" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PortalAttemptResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string" },
              "installmentNumber": { "type": "integer", "minimum": 1 },
              "paymentUrl": { "type": "string", "format": "uri" },
              "receiptReady": { "type": "boolean" },
              "lastCheckedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
