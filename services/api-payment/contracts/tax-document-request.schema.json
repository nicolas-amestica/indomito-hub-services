{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://girasindomito.cl/schemas/payments/tax-document-request-v1.json",
  "title": "Tax document request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "sourceEventId", "tripId", "documentKind", "currency", "grossAmount", "status", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "sourceEventId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "tripId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "documentKind": { "enum": ["BOLETA", "FACTURA", "NOTA_CREDITO", "NOTA_DEBITO"] },
    "currency": { "const": "CLP" },
    "grossAmount": { "type": "integer", "minimum": 1, "maximum": 1000000000000 },
    "status": { "enum": ["PENDING_CLASSIFICATION", "READY", "SUBMITTED", "ACCEPTED", "REJECTED", "VOIDED", "REQUIRES_REVIEW"] },
    "requestedAt": { "type": "string", "format": "date-time" },
    "issuerConfigurationVersion": { "type": "integer", "minimum": 1 },
    "externalDocumentId": { "type": "string", "maxLength": 128 },
    "externalStatusCode": { "type": "string", "maxLength": 64 },
    "reversalOfRequestId": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" }
  }
}
