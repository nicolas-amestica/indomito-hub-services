go 1.25.0

// Cada microservicio en services/<nombre>/ es un modulo Go independiente y
// debe agregarse a este bloque `use` para que el workspace lo compile.
// Ejemplo al crear services/api-viajes/:
//
//   use (
//     .
//     ./services/api-viajes
//   )
use (
	.
	./libs
	./services/api-catalog
	./services/api-contract
	./services/api-identity
	./services/api-inbox
	./services/api-meet
	./services/api-payment
	./services/api-program
	./services/payment-monitoring
	./services/payment-receipts
)
